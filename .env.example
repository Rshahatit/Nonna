# ============================================
# Nonna — Environment Variables
# ============================================

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Firestore
FIRESTORE_DATABASE=(default)

# Google Cloud Storage
GCS_BUCKET_TRANSCRIPTS=nonna-transcripts
GCS_BUCKET_MEDIA=nonna-media
GCS_BUCKET_REELS=nonna-reels

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-pro
GEMINI_LIVE_MODEL=gemini-2.5-flash-exp

# Vertex AI (Imagen 3)
VERTEX_AI_LOCATION=us-central1

# Google Cloud Text-to-Speech
TTS_VOICE_NAME=en-US-Journey-F
TTS_SPEAKING_RATE=0.9

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Backend
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_PORT=3000

# Cloud Tasks
CLOUD_TASKS_QUEUE=nonna-reel-pipeline
CLOUD_TASKS_LOCATION=us-central1

# ============================================
# Phase 2 — Family Organization
# ============================================

# Firebase Auth
FIREBASE_PROJECT_ID=your-gcp-project-id

# SendGrid (email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key

# Firebase (frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id
